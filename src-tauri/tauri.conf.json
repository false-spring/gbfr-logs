{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "GBFR Logs",
    "version": "2.0.4-73"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "window": {
        "all": false,
        "close": true,
        "hide": true,
        "show": true,
        "maximize": true,
        "minimize": true,
        "unmaximize": true,
        "unminimize": true,
        "startDragging": true
      },
      "fs": {
        "readFile": true,
        "scope": [
          "$RESOURCE/*",
          "$RESOURCE/lang/*",
          "$RESOURCE/lang/*/*",
          "$RESOURCE/assets/*",
          "$RESOURCE/assets/*/*"
        ]
      },
      "path": {
        "all": true
      }
    },
    "windows": [
      {
        "title": "Meter",
        "label": "main",
        "fullscreen": false,
        "width": 700,
        "height": 420,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "minWidth": 540,
        "minHeight": 180,
        "alwaysOnTop": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu"
      },
      {
        "title": "Logs",
        "label": "logs",
        "url": "/logs",
        "fullscreen": false,
        "width": 800,
        "height": 600,
        "minWidth": 400,
        "minHeight": 300,
        "resizable": true,
        "closable": true,
        "decorations": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; style-src-elem 'self' 'unsafe-inline'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: https://ipc.localhost https://relink.cleista.cc; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'"
    },
    "bundle": {
      "active": true,
      "targets": [
        "msi"
      ],
      "identifier": "com.false",
      "longDescription": "GBFR Logs - DPS Meter for Granblue Fantasy: Relink",
      "shortDescription": "GBFR Logs",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "resources": [
        "hook.dll",
        "assets/*",
        "lang/*"
      ],
      "windows": {
        "webviewInstallMode": {
          "type": "embedBootstrapper"
        }
      }
    },
    "systemTray": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true
    },
    "updater": {
      "active": false,
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDQjZEMTgxOEY4OTIwNDcKUldSSElJbVBnZEcyM1BSUklxWWRsWStXYnVsWU1mODY3YzZCWCtTZzJrUGJsZHpNY1h1S3hhc2cK",
      "endpoints": [
        "https://raw.githubusercontent.com/false-spring/gbfr-logs/main/update.json"
      ],
      "windows": {
        "installMode": "basicUi"
      }
    }
  }
}
